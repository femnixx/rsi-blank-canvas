  STD->>UI: 2 submitAttendance(nim)
  UI->>AC: 3 recordAttendance(nim, workshop_id)
  AC->>W: 4 checkSessionOngoing(workshop_id)
  AC->>R: 5 matchRoster(nim, workshop_id)
  alt not on roster
    AC-->>UI: 9 showError(NOT_REGISTERED)
  else on roster
    AC->>A: 6 checkExisting(registration_id)
